# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# SQLite Database
DATABASE_URL=sqlite:///./post_generator.db

# LLM & Search API Keys (for Phase 2 & 3)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# LLM model. Must support structured output - every node depends on it.
# openai/gpt-oss-120b is the tested choice: it supports json_schema natively and
# judges candidates more strictly than the llama models, which matters because the
# editorial thresholds were calibrated against it.
# llama-3.3-70b-versatile also works (routed through tool calling automatically) but
# is measurably more lenient and returns a malformed call about 1 time in 3.
# Check /health after deploying: canPublish must be true.
LLM_MODEL=openai/gpt-oss-120b

# Agent Cadence Bounds (in hours)
CADENCE_MIN_HOURS=2.0
CADENCE_MAX_HOURS=5.0

# Safety limit: stop this agent after this many published posts in its 48-hour window
MAX_POSTS_48H=16

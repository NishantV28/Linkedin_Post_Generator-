# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# SQLite Database
DATABASE_URL=sqlite:///./post_generator.db

# LLM & Search API Keys (for Phase 2 & 3)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# LLM Model Override (Optional: defaults to llama-3.3-70b-versatile for Groq or gpt-4o-mini for OpenAI)
LLM_MODEL=llama-3.3-70b-versatile

# Agent Cadence Bounds (in hours)
CADENCE_MIN_HOURS=2.0
CADENCE_MAX_HOURS=5.0

# Safety limit: stop this agent after this many published posts in its 48-hour window
MAX_POSTS_48H=16
